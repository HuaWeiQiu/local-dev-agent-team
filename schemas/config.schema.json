{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HuaWeiQiu/local-dev-agent-team/raw/main/schemas/config.schema.json",
  "title": "Local Dev Agent Team configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "profiles", "roles", "quality", "github"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "defaultBranch", "stateDirectory", "maxParallel"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "defaultBranch": { "type": "string", "minLength": 1 },
        "stateDirectory": { "type": "string", "minLength": 1 },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/role" }
    },
    "strategies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "definitions"],
      "properties": {
        "default": { "type": "string", "minLength": 1 },
        "definitions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/strategy" }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxEventsPerRun": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000000,
          "default": 50000
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "maxReworkAttempts", "commandTimeoutSeconds"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "maxReworkAttempts": { "type": "integer", "minimum": 0, "maximum": 10 },
        "commandTimeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "remote",
        "draftPullRequest",
        "autoMerge",
        "checkTimeoutSeconds",
        "maxRepairAttempts",
        "repairForbiddenPaths"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "remote": { "type": "string", "minLength": 1 },
        "draftPullRequest": { "type": "boolean" },
        "autoMerge": { "const": false },
        "checkTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "maxRepairAttempts": { "type": "integer", "minimum": 0, "maximum": 5 },
        "repairForbiddenPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model", "reasoning", "permission", "timeoutSeconds"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "executable": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoning": {
          "enum": ["low", "medium", "high", "xhigh", "max"]
        },
        "permission": {
          "enum": ["read-only", "workspace-write"]
        },
        "externalTools": {
          "enum": ["deny", "inherit"],
          "default": "deny"
        },
        "nativeProfile": { "type": "string", "minLength": 1 },
        "codexProvider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "baseUrl"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "name": { "type": "string", "minLength": 1 },
            "baseUrl": { "type": "string", "format": "uri" },
            "wireApi": { "const": "responses", "default": "responses" },
            "requiresOpenAIAuth": { "type": "boolean", "default": true },
            "supportsWebSockets": { "type": "boolean", "default": false }
          }
        },
        "maxTurns": { "type": "integer", "minimum": 1, "maximum": 100 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["permission"],
            "properties": { "permission": { "const": "read-only" } }
          },
          "then": {
            "properties": { "externalTools": { "const": "deny" } }
          }
        },
        {
          "if": { "required": ["nativeProfile"] },
          "then": {
            "required": ["externalTools"],
            "properties": {
              "adapter": { "const": "codex" },
              "externalTools": { "const": "inherit" }
            }
          }
        },
        {
          "if": { "required": ["codexProvider"] },
          "then": {
            "properties": {
              "adapter": { "const": "codex" }
            }
          }
        },
        {
          "if": { "required": ["maxTurns"] },
          "then": {
            "properties": {
              "adapter": { "const": "grok" }
            }
          }
        }
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultProfile", "allowedProfiles"],
      "properties": {
        "defaultProfile": { "type": "string", "minLength": 1 },
        "allowedProfiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "fallbackProfiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "promptFile": { "type": "string", "minLength": 1 }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": ["parallel-dag", "sequential"],
              "default": "parallel-dag"
            }
          }
        },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxReworkAttempts": { "type": "integer", "minimum": 0, "maximum": 10 },
        "executionTimeoutSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800
        },
        "maxAgentInvocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxProcessOutputBytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 16777216
        },
        "maxArtifactBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 10737418240
        },
        "approvalGates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "contains": { "const": "final" },
          "items": { "enum": ["plan", "final"] }
        },
        "approvalTimeoutSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800
        },
        "roleProfiles": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["topology"],
            "properties": {
              "topology": {
                "required": ["mode"],
                "properties": { "mode": { "const": "sequential" } }
              }
            }
          },
          "then": {
            "properties": { "maxParallel": { "const": 1 } }
          }
        }
      ]
    }
  }
}
