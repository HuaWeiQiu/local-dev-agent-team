{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HuaWeiQiu/local-dev-agent-team/raw/main/schemas/config.schema.json",
  "title": "Local Dev Agent Team configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "profiles", "roles", "quality", "github"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "defaultBranch", "stateDirectory", "maxParallel"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "defaultBranch": { "type": "string", "minLength": 1 },
        "stateDirectory": { "type": "string", "minLength": 1 },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/role" }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "maxReworkAttempts", "commandTimeoutSeconds"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "maxReworkAttempts": { "type": "integer", "minimum": 0, "maximum": 10 },
        "commandTimeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "remote",
        "draftPullRequest",
        "autoMerge",
        "checkTimeoutSeconds",
        "maxRepairAttempts",
        "repairForbiddenPaths"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "remote": { "type": "string", "minLength": 1 },
        "draftPullRequest": { "type": "boolean" },
        "autoMerge": { "const": false },
        "checkTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "maxRepairAttempts": { "type": "integer", "minimum": 0, "maximum": 5 },
        "repairForbiddenPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model", "reasoning", "permission", "timeoutSeconds"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "executable": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoning": {
          "enum": ["low", "medium", "high", "xhigh", "max"]
        },
        "permission": {
          "enum": ["read-only", "workspace-write"]
        },
        "nativeProfile": { "type": "string", "minLength": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultProfile", "allowedProfiles"],
      "properties": {
        "defaultProfile": { "type": "string", "minLength": 1 },
        "allowedProfiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "fallbackProfiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "promptFile": { "type": "string", "minLength": 1 }
      }
    }
  }
}
