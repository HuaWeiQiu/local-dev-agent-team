{
  "name": "local-dev-agent-team",
  "version": "0.1.0",
  "description": "Local-first orchestration for profile-driven software development agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuaWeiQiu/local-dev-agent-team.git"
  },
  "bugs": {
    "url": "https://github.com/HuaWeiQiu/local-dev-agent-team/issues"
  },
  "homepage": "https://github.com/HuaWeiQiu/local-dev-agent-team#readme",
  "keywords": [
    "agents",
    "codex",
    "claude-code",
    "multi-agent",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "agent-team": "dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist",
    "prompts",
    "schemas",
    "agent-team.example.yaml",
    "agent-team.workspace.example.yaml"
  ],
  "scripts": {
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "check": "pnpm check:server && pnpm check:web",
    "check:server": "tsc -p tsconfig.json --noEmit",
    "check:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test --config web/playwright.config.ts",
    "desktop:prepare": "pnpm build && node scripts/prepare-desktop-runtime.mjs",
    "desktop:dev": "pnpm desktop:prepare && tauri dev --no-watch",
    "desktop:build": "tauri build",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "dev": "tsx src/cli.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "prepack": "pnpm check && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.0",
    "minimatch": "^10.2.6",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.33.0"
}
